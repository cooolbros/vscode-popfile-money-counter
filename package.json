{
    "name": "vscode-popfile-money-counter",
    "displayName": "VSCode Popfile Money Counter",
    "description": "Extension for counting the money in an mvm popfile",
    "version": "1.2.6",
    "publisher": "pfwobcke",
    "icon": "bootcamp.png",
    "keywords": [
        "tf2",
        "mvm",
        "pop"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/cooolbros/vscode-popfile-money-counter"
    },
    "engines": {
        "vscode": "^1.61.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onCommand:vscode-popfile-money-counter.countMoney"
    ],
    "main": "./dist/extension.js",
    "browser": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "vscode-popfile-money-counter.countMoney",
                "title": "Count Money"
            }
        ]
    },
    "scripts": {
        "vscode:prepublish": "pnpm build",
        "dev": "rspack build --watch --mode none",
        "build": "rspack build",
        "lint": "oxlint",
        "browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ."
    },
    "devDependencies": {
        "@rspack/cli": "^2.3.2",
        "@rspack/core": "^2.3.2",
        "@types/vscode": "^1.61.0",
        "@vscode/test-web": "^0.0.81",
        "@vscode/vsce": "^4.1.0",
        "ovsx": "^1.4.0",
        "oxlint": "^1.93.0",
        "oxlint-config": "github:cooolbros/oxlint-config",
        "oxlint-tsgolint": "^7.0.2007",
        "ts-checker-rspack-plugin": "^1.8.0",
        "typescript": "^7.0.2"
    },
    "vsce": {
        "dependencies": false
    },
    "packageManager": "pnpm@12.18.0"
}
