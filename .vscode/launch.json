{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--profile-temp",
                "--extensionDevelopmentPath=${workspaceFolder}",
            ],
            "outFiles": [
                "${workspaceFolder}/dist/*.js"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ]
        }
    ]
}
